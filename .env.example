# Base URL of the Express backend. No trailing slash.
VITE_API_BASE_URL=http://localhost:5000/api

# Where poster/backdrop paths are served from.
# Leave blank if your backend already returns absolute image URLs.
VITE_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Never put secrets here. Anything prefixed with VITE_ is compiled into the
# JavaScript bundle and is readable by anyone who opens the site.
